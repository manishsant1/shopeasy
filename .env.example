# Copy this file to .env and fill in your Neon connection string
# (Neon console > your project > Connect). Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
PORT=3000

# --- Grafana Cloud observability (optional; leave commented out to disable) ---
# Grafana Cloud > your stack > OpenTelemetry (Configure) shows the exact endpoint and instance ID.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Authorization = "Basic " + base64("<instance-id>:<access-policy-token>"). The space must be %20 here.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64_OF_INSTANCEID_COLON_TOKEN
# OTEL_SERVICE_NAME=shopeasy
